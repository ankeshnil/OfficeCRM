    <script>
        function getChildLookupList(ddlParent, ddlChild) {
            getChildLookupListMulty(ddlParent, ddlChild, 0)

        }

        function getChildLookupListMulty(ddlParent, ddlChild, master) {
            debugger;
            var parentLookupId = $("#" + ddlParent).val();
            $.ajax
                ({
                    url: '/Master/GetChildLookupList',
                    type: 'POST',
                    datatype: 'application/json',
                    contentType: 'application/json',
                    data: JSON.stringify({
                        parentLookupId: +parentLookupId, something: 'value'
                    }),
                    success: function (result) {
                        $("#" + ddlChild).html("");
                        $("#" + ddlChild).append
                            ($('<option></option>').val(null).html('Select'))
                        $.each($.parseJSON(result), function (i, lookupDetails) {
                            if (master > 0) {
                                if (lookupDetails.LookupMasterId == master) {
                                    $("#" + ddlChild).append
                                        ($('<option></option>').val(lookupDetails.LookupDetailsId).html(lookupDetails.LookupDetailsName))
                                }
                            }
                            else
                                $("#" + ddlChild).append
                                    ($('<option></option>').val(lookupDetails.LookupDetailsId).html(lookupDetails.LookupDetailsName))
                        })
                    },
                    error: function () {
                        alert("Whooaaa! Something went wrong..")
                    },
                });


        }


        function GetParentValue(ddlParent) {
            var parentLookupId = $("#" + ddlParent).val();
            $.ajax
                ({
                    url: '/Master/GetParentValue',
                    type: 'POST',
                    datatype: 'application/json',
                    contentType: 'application/json',
                    data: JSON.stringify({
                        parentLookupId: +parentLookupId
                    }),
                    success: function (result) {
                        var sresult = result;
                        var ss = sresult.replace(/"/g, '');
                        $('#txtStockAddress').val(ss);

                    },
                    error: function () {
                        alert("Whooaaa! Something went wrong..")
                    },
                });
        }


        function SortDDLByText(selectId) {
            //store the selected value.
            //alert(selectId);
            var selectedVal = $('#' + selectId).val();
            ///start sorting.
            //$('#' + selectId).html($('#' + selectId + " option").sort(function (a, b) {
            //    return a.text == $('#' + selectId + ' option:first').text ? -1 : a.text < b.text ? -1 : 1;
            //}));
            var foption = $('#' + selectId + ' option:first');
            var soptions = $('#' + selectId + ' option:not(:first)').sort(function (a, b) {
                return a.text == b.text ? 0 : a.text < b.text ? -1 : 1
            });
            $('#' + selectId).html(soptions).prepend(foption);
            ///re-select the preserved value.
            $('#' + selectId).val(selectedVal);
        }
    </script>
